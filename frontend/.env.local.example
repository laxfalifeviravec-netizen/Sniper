# Database (Neon Postgres — serverless, works great on Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=your-secret-key-min-32-chars-change-this

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — verification, password reset, order & lead notifications)
RESEND_API_KEY=re_xxxxx

# SMS (Twilio — Shop Pro instant lead alerts)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Stripe (billing — subscriptions + one-time part sales)
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_SHOP_PRICE_ID=price_xxxxx

# Admin dashboard access (comma-separated emails)
ADMIN_EMAILS=you@example.com
